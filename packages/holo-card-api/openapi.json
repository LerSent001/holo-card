{
  "openapi": "3.1.0",
  "info": {
    "title": "Holo Card API",
    "version": "1.0.0",
    "description": "Server-side Gemini segmentation and HDR WebGL card generation. API token authentication is independent of browser login. Keep Gemini keys on the server. Uploads, reads and previews do not trigger generation. Model output quality is not automatically certified."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "holo_…"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            }
          }
        }
      },
      "Layer": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "background",
              "ui",
              "structure"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "submitting",
              "in_progress",
              "completed",
              "failed",
              "uncertain"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "submitted_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "completed_at": {
            "type": [
              "integer",
              "null"
            ]
          },
          "usage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "card_id",
          "status",
          "progress",
          "layers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "card_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "assembling",
              "completed",
              "failed",
              "uncertain"
            ]
          },
          "created_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "model": {
            "type": "string"
          },
          "max_image_calls": {
            "type": "integer",
            "const": 4
          },
          "progress": {
            "type": "object",
            "properties": {
              "completed_layers": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "total_layers": {
                "type": "integer",
                "const": 4
              }
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Layer"
            }
          },
          "card_url": {
            "type": "string"
          }
        }
      },
      "Card": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status",
          "layers"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploaded",
              "queued",
              "running",
              "assembling",
              "completed",
              "failed",
              "uncertain"
            ]
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "created_at": {
            "type": "integer"
          },
          "source_sha256": {
            "type": "string"
          },
          "original_url": {
            "type": "string"
          },
          "source_url": {
            "type": "string"
          },
          "job_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "rgba_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "mask_url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "bundle_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "preview_link_endpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "assembly": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          }
        }
      },
      "PreviewLink": {
        "type": "object",
        "required": [
          "preview_url",
          "expires_in"
        ],
        "properties": {
          "preview_url": {
            "type": "string",
            "format": "uri"
          },
          "expires_in": {
            "type": "integer",
            "const": 900
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness only",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Read this API contract",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Read service configuration; does not call Gemini",
        "security": [
          {
            "bearerAuth": []
