                    "version": {
                      "type": "string"
                    },
                    "provider": {
                      "type": "string"
                    },
                    "provider_configured": {
                      "type": "boolean"
                    },
                    "model": {
                      "type": "string"
                    },
                    "scopes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "max_image_calls_per_card": {
                      "type": "integer"
                    },
                    "completed_generations": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Failure. Never automatically repeat a paid submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Failure. Never automatically repeat a paid submission.",
            "content": {
